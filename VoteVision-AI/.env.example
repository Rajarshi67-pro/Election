# VoteVision AI - Environment Configuration Example
# Copy to .env and configure for your local/production environment

# Flask Server Configuration
FLASK_ENV=development
SECRET_KEY=your-secure-secret-key-here
HOST=0.0.0.0
PORT=5000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=*

# Paths (optional overrides)
# DATASET_PATH=data/cleaned_dataset.csv
# MODEL_PATH=ml/saved_model.pkl
# PREPROCESSOR_PATH=ml/preprocessor.pkl
